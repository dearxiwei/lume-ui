{
  "name": "@lume/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lume 质感组件库：flex 自适应 / 毛玻璃可选 / 安卓震动 / 默认曲线动效（纯 Vue，无第三方 UI 依赖）",
  "files": ["dist", "src"],
  "main": "./dist/lume.umd.cjs",
  "module": "./dist/lume.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lume.js",
      "require": "./dist/lume.umd.cjs"
    },
    "./style.css": "./dist/lume.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "audit": "node scripts/audit-colors.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
